generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dc_users {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  nama       String
  cabang     String
  role       String
  nama_pt         String?
  last_login      DateTime?
  akses_menu      String?
  coverage_cabang String?
}

model dc_project {
  id                      Int           @id @default(autoincrement())
  kode                    String        @unique
  nama_proyek             String
  dc_induk                String?
  tipe                    String
  cabang                  String
  inisial                 String?
  tanggal_go              DateTime?     @db.Date
  masa_sewa_start         DateTime?     @db.Date
  masa_sewa_finish        DateTime?     @db.Date
  kapasitas_toko          Int?
  luas_lahan              Float?
  total_luas_bangunan     Float?
  luas_office_lt1         Float?
  luas_office_lt2         Float?
  luas_warehouse          Float?
  luas_mezanine           Float?
  luas_cold_storage       Float?
  luas_bangunan_penunjang Float?
  luas_area_parkir        Float?
  luas_tapak_terbangun    Float?
  kdb_persen              Float?
  sisa_lahan              Float?
  main_kontraktor         String?
  daya_listrik            String?
  genset                  String?
  sumber_air              String?
  spek_lantai_tonase      Float?
  spek_lantai_tebal       Float?
  spek_lantai_mutu_beton  String?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  dokumen                 dc_dokumen[]
}

model dc_dokumen {
  id              Int      @id @default(autoincrement())
  project_id      Int
  fase_proyek     String   // "PEMBANGUNAN", "RENOVASI", "PERLUASAN"
  kategori        String
  nama_item       String
  jenis_file      String   // "PDF/JPEG", "AUTOCAD", dll
  
  file_url        String?
  file_name       String?
  catatan         String?
  is_custom       Boolean  @default(false)
  
  updated_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  project         dc_project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  riwayat         dc_dokumen_riwayat[]
  
  @@unique([project_id, fase_proyek, kategori, nama_item])
}

model dc_dokumen_riwayat {
  id              Int        @id @default(autoincrement())
  dokumen_id      Int
  action          String     // "UPLOAD_FILE", "UPDATE_CATATAN", "ADD_CUSTOM_ITEM", "DELETE_FILE"
  deskripsi_log   String
  created_by      String
  created_at      DateTime   @default(now())
  
  dokumen         dc_dokumen @relation(fields: [dokumen_id], references: [id], onDelete: Cascade)
}

// --- MASTER HARGA MODULE ---

model mh_master_item {
  id                   Int       @id @default(autoincrement())
  kode                 String?
  kode_anak            String    @unique
  abjad_lokasi         String?
  lingkup              String    @default("SIPIL") // "SIPIL" or "ME"
  kategori_pekerjaan   String
  item_material        String
  ukuran_dimensi       String?
  merk_brand           String?
  warna_corak          String?
  tipe_produk          String?
  ketebalan            String?
  finishing_permukaan  String?
  toleransi            String?
  implementasi         String?
  lokasi_penerapan     String?
  informasi_tambahan   String?
  deskripsi_otomatis   String    @db.Text
  email_pembuat        String?
  
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  koefisien            mh_analisa_koefisien[]
  item_cabang          mh_item_cabang[]
  harga_upah_cabang    mh_harga_upah_item_cabang[]
}

model mh_komponen_dasar {
  id              Int       @id @default(autoincrement())
  kategori        String    // "UPAH" | "MATERIAL"
  nama_komponen   String
  satuan          String
  email           String?
  
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  harga_cabang    mh_harga_material_item_cabang[]
  koefisien_item  mh_analisa_koefisien[]
  harga_upah_cabang mh_harga_upah_item_cabang[]
}

model mh_harga_material_item_cabang {
  id              Int       @id @default(autoincrement())
  komponen_id     Int
  cabang          String
  coverage_cabang String    @default("")
  harga_satuan    Float
  
  updated_at      DateTime  @updatedAt

  komponen        mh_komponen_dasar @relation(fields: [komponen_id], references: [id], onDelete: Cascade)

  @@unique([komponen_id, cabang, coverage_cabang])
}

model mh_analisa_koefisien {
  id               Int       @id @default(autoincrement())
  master_item_id   Int
  komponen_id      Int
  tipe             String    // "UPAH" | "MATERIAL"
  volume_koefisien Float
  
  master_item      mh_master_item    @relation(fields: [master_item_id], references: [id], onDelete: Cascade)
  komponen         mh_komponen_dasar @relation(fields: [komponen_id], references: [id], onDelete: Cascade)

  @@unique([master_item_id, komponen_id])
}

model mh_item_cabang {
  id               Int       @id @default(autoincrement())
  master_item_id   Int
  cabang           String
  coverage_cabang  String    @default("")
  
  total_upah       Float
  total_material   Float
  harga_kalkulasi  Float
  harga_release    Float
  status_aktif     Boolean   @default(false)
  
  updated_at       DateTime  @updatedAt

  master_item      mh_master_item @relation(fields: [master_item_id], references: [id], onDelete: Cascade)

  @@unique([master_item_id, cabang, coverage_cabang])
}

model mh_kategori_pekerjaan {
  id       Int    @id @default(autoincrement())
  lingkup  String // "SIPIL" or "ME"
  nama     String
  
  @@unique([lingkup, nama])
}



model mh_harga_upah_item_cabang {
  id               Int       @id @default(autoincrement())
  master_item_id   Int
  komponen_id      Int
  cabang           String
  coverage_cabang  String    @default("")
  harga_satuan     Float

  master_item      mh_master_item    @relation(fields: [master_item_id], references: [id], onDelete: Cascade)
  komponen         mh_komponen_dasar @relation(fields: [komponen_id], references: [id], onDelete: Cascade)

  @@unique([master_item_id, komponen_id, cabang, coverage_cabang])
}


model app_audit_log {
  id           Int       @id @default(autoincrement())
  user_email   String
  modul        String
  entitas      String
  entitas_id   String
  aksi         String
  data_lama    Json?
  data_baru    Json?
  created_at   DateTime  @default(now())
}

