generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dc_users {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  nama       String
  cabang     String
  role       String
  nama_pt         String?
  last_login      DateTime?
  akses_menu      String?
  coverage_cabang String?
}

model dc_project {
  id                      Int           @id @default(autoincrement())
  kode                    String        @unique
  nama_proyek             String
  dc_induk                String?
  tipe                    String
  cabang                  String
  inisial                 String?
  tanggal_go              DateTime?     @db.Date
  masa_sewa_start         DateTime?     @db.Date
  masa_sewa_finish        DateTime?     @db.Date
  kapasitas_toko          Int?
  luas_lahan              Float?
  total_luas_bangunan     Float?
  luas_office_lt1         Float?
  luas_office_lt2         Float?
  luas_warehouse          Float?
  luas_mezanine           Float?
  luas_cold_storage       Float?
  luas_bangunan_penunjang Float?
  luas_area_parkir        Float?
  luas_tapak_terbangun    Float?
  kdb_persen              Float?
  sisa_lahan              Float?
  main_kontraktor         String?
  daya_listrik            String?
  genset                  String?
  sumber_air              String?
  spek_lantai_tonase      Float?
  spek_lantai_tebal       Float?
  spek_lantai_mutu_beton  String?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  dokumen                 dc_dokumen[]
  renovasi                dc_renovasi[]
  fungsi_ruang            dc_fungsi_ruang[]
}

model dc_dokumen {
  id              Int      @id @default(autoincrement())
  project_id      Int
  fase_proyek     String   // "PEMBANGUNAN", "RENOVASI", "PERLUASAN"
  kategori        String
  nama_item       String
  jenis_file      String   // "PDF/JPEG", "AUTOCAD", dll
  
  file_url        String?
  file_name       String?
  catatan         String?
  is_custom       Boolean  @default(false)
  
  updated_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  project         dc_project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  riwayat         dc_dokumen_riwayat[]
  
  @@unique([project_id, fase_proyek, kategori, nama_item])
}

model dc_dokumen_riwayat {
  id              Int        @id @default(autoincrement())
  dokumen_id      Int
  action          String     // "UPLOAD_FILE", "UPDATE_CATATAN", "ADD_CUSTOM_ITEM", "DELETE_FILE"
  deskripsi_log   String
  created_by      String
  created_at      DateTime   @default(now())
  
  dokumen         dc_dokumen @relation(fields: [dokumen_id], references: [id], onDelete: Cascade)
}

// --- MASTER HARGA MODULE ---

model mh_master_item {
  id                   Int       @id @default(autoincrement())
  kode                 String?
  kode_anak            String    @unique
  abjad_lokasi         String?
  lingkup              String    @default("SIPIL") // "SIPIL" or "ME"
  kategori_pekerjaan   String
  item_material        String
  ukuran_dimensi       String?
  merk_brand           String?
  warna_corak          String?
  tipe_produk          String?
  ketebalan            String?
  finishing_permukaan  String?
  toleransi            String?
  implementasi         String?
  lokasi_penerapan     String?
  informasi_tambahan   String?
  deskripsi_otomatis   String    @db.Text
  email_pembuat        String?
  
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  koefisien            mh_analisa_koefisien[]
  item_cabang          mh_item_cabang[]
  harga_upah_cabang    mh_harga_upah_item_cabang[]
  renovasi_item        dc_renovasi_item[]
}

model mh_komponen_dasar {
  id              Int       @id @default(autoincrement())
  kategori        String    // "UPAH" | "MATERIAL"
  nama_komponen   String
  satuan          String
  email           String?
  
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  harga_cabang    mh_harga_material_item_cabang[]
  koefisien_item  mh_analisa_koefisien[]
  harga_upah_cabang mh_harga_upah_item_cabang[]
}

model mh_harga_material_item_cabang {
  id              Int       @id @default(autoincrement())
  komponen_id     Int
  cabang          String
  coverage_cabang String    @default("")
  harga_satuan    Float
  
  updated_at      DateTime  @updatedAt

  komponen        mh_komponen_dasar @relation(fields: [komponen_id], references: [id], onDelete: Cascade)

  @@unique([komponen_id, cabang, coverage_cabang])
}

model mh_analisa_koefisien {
  id               Int       @id @default(autoincrement())
  master_item_id   Int
  komponen_id      Int
  tipe             String    // "UPAH" | "MATERIAL"
  volume_koefisien Float
  
  master_item      mh_master_item    @relation(fields: [master_item_id], references: [id], onDelete: Cascade)
  komponen         mh_komponen_dasar @relation(fields: [komponen_id], references: [id], onDelete: Cascade)

  @@unique([master_item_id, komponen_id])
}

model mh_item_cabang {
  id               Int       @id @default(autoincrement())
  master_item_id   Int
  cabang           String
  coverage_cabang  String    @default("")
  
  total_upah       Float
  total_material   Float
  harga_kalkulasi  Float
  harga_release    Float
  status_aktif     Boolean   @default(false)
  
  updated_at       DateTime  @updatedAt

  master_item      mh_master_item @relation(fields: [master_item_id], references: [id], onDelete: Cascade)

  @@unique([master_item_id, cabang, coverage_cabang])
}

model mh_kategori_pekerjaan {
  id       Int    @id @default(autoincrement())
  lingkup  String // "SIPIL" or "ME"
  nama     String
  
  @@unique([lingkup, nama])
}



model mh_harga_upah_item_cabang {
  id               Int       @id @default(autoincrement())
  master_item_id   Int
  komponen_id      Int
  cabang           String
  coverage_cabang  String    @default("")
  harga_satuan     Float

  master_item      mh_master_item    @relation(fields: [master_item_id], references: [id], onDelete: Cascade)
  komponen         mh_komponen_dasar @relation(fields: [komponen_id], references: [id], onDelete: Cascade)

  @@unique([master_item_id, komponen_id, cabang, coverage_cabang])
}


model app_audit_log {
  id           Int       @id @default(autoincrement())
  user_email   String
  modul        String
  entitas      String
  entitas_id   String
  aksi         String
  data_lama    Json?
  data_baru    Json?
  created_at   DateTime  @default(now())
}

// --- Penawaran RAB/OE MODULE ---

model dc_renovasi {
  id                 Int                    @id @default(autoincrement())
  nomor_pengajuan    String                 @unique
  project_id         Int
  jenis_renovasi     String
  lingkup_pekerjaan  String                 @default("Sipil + ME")
  durasi_hari        Int                    @default(0)
  satuan_durasi      String                 @default("Hari")
  status             String                 @default("DRAFT") // DRAFT, MENUNGGU APPROVAL B&M MANAGER, REVISI, APPROVED, DITOLAK
  total_biaya_sipil  Float                  @default(0)
  total_biaya_me     Float                  @default(0)
  total_sebelum_ppn  Float                  @default(0)
  nilai_ppn          Float                  @default(0)
  nilai_pembulatan   Float                  @default(0)
  grand_total        Float                  @default(0)
  catatan_pengajuan  String?
  created_by         String                 // email user
  cabang             String
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt

  project            dc_project             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  dokumen            dc_renovasi_dokumen[]
  item_rab           dc_renovasi_item[]
  fungsi_ruang       dc_fungsi_ruang[]
}

model dc_renovasi_dokumen {
  id                  Int          @id @default(autoincrement())
  renovasi_id         Int
  kategori_file       String       // "GAMBAR_SIPIL", "GAMBAR_ME", "FOTO_LINGKUNGAN"
  nama_file           String
  nama_label          String?      // Nama / Deskripsi foto
  file_url            String?      // Link Google Drive
  drive_file_id       String?
  mime_type           String?
  latitude            Float?
  longitude           Float?
  timestamp_watermark DateTime?
  created_at          DateTime     @default(now())

  renovasi            dc_renovasi  @relation(fields: [renovasi_id], references: [id], onDelete: Cascade)
}

model dc_renovasi_item {
  id                 Int             @id @default(autoincrement())
  renovasi_id        Int
  lingkup            String          // "SIPIL" or "ME"
  kategori_pekerjaan String
  master_item_id     Int?            // Nullable jika custom item
  deskripsi          String
  harga_material     Float           @default(0)
  harga_upah         Float           @default(0)
  volume             Float           @default(0)
  total_material     Float           @default(0)
  total_upah         Float           @default(0)
  total_biaya        Float           @default(0)
  catatan            String?
  is_custom          Boolean         @default(false)
  created_at         DateTime        @default(now())

  renovasi           dc_renovasi     @relation(fields: [renovasi_id], references: [id], onDelete: Cascade)
  master_item        mh_master_item? @relation(fields: [master_item_id], references: [id], onDelete: SetNull)
}

// --- Pengajuan Perubahan Fungsi Ruang (PFR) MODULE ---

model dc_fungsi_ruang {
  id               Int          @id @default(autoincrement())
  nomor_pengajuan  String       @unique
  renovasi_id      Int
  project_id       Int
  
  // Identitas Pemohon
  nama_pemohon     String
  email_pemohon    String
  jabatan          String
  divisi           String
  departemen       String
  
  // Data Pengajuan Ruang
  jenis_pengajuan  String       // "Perubahan Fungsi Ruang" | "Pengurangan Fungsi Ruang" | "Penambahan Fungsi Ruang"
  alasan_pengajuan String       @db.Text
  
  // Alur Approval
  status           String       @default("MENUNGGU APPROVAL BM/DBM")
  
  // Google Drive File
  file_url         String?      // Link Google Drive
  drive_file_id    String?

  created_by       String       // email maker (B&M Manager / Admin)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  renovasi         dc_renovasi  @relation(fields: [renovasi_id], references: [id], onDelete: Cascade)
  project          dc_project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

