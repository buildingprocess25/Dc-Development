<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Berita Acara Aanwijzing - {{ klarifikasi.nomor_klarifikasi }}</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 12mm 15mm 15mm 15mm;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 9.5px;
      color: #1f2937;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      line-height: 1.4;
      position: relative;
    }

    /* Watermark Logo SPARTA */
    .watermark-img {
      position: fixed;
      top: 50%;
      left: 50%;
      width: 400px;
      transform: translate(-50%, -50%);
      opacity: 0.04;
      z-index: -1;
      pointer-events: none;
    }

    /* Header Banner Oranye SPARTA */
    .header-main {
      background-color: #E65F2B;
      color: #ffffff;
      padding: 11px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 15px;
      border-radius: 4px;
    }

    .header-alfamart-logo {
      height: 34px;
      margin-right: 12px;
      padding-right: 12px;
      border-right: 2px solid rgba(255, 255, 255, 0.35);
      object-fit: contain;
    }

    .header-sparta-logo {
      height: 28px;
      margin-right: 8px;
      object-fit: contain;
    }

    .header-title {
      font-size: 19px;
      font-weight: bold;
      margin: 0;
      letter-spacing: 1.5px;
      line-height: 1.1;
      color: #ffffff;
    }

    .header-subtitle {
      font-size: 9.5px;
      margin: 0;
      opacity: 0.88;
      letter-spacing: 0.5px;
      color: #ffffff;
    }

    /* Status Badges */
    .status-badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 8px;
      font-weight: bold;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      background-color: #ffffff;
      color: #E65F2B;
      border: 1px solid rgba(230, 95, 43, 0.3);
    }

    .status-badge.approved {
      background-color: #ecfdf5;
      color: #047857;
      border-color: #a7f3d0;
    }

    .status-badge.revisi {
      background-color: #fffbeb;
      color: #b45309;
      border-color: #fde68a;
    }

    .status-badge.pending {
      background-color: #eff6ff;
      color: #1d4ed8;
      border-color: #bfdbfe;
    }

    /* Section Title */
    .section-title {
      font-size: 10.5px;
      font-weight: bold;
      color: #E65F2B;
      border-bottom: 1.5px solid #E65F2B;
      padding-bottom: 3.5px;
      margin-top: 14px;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    /* Metadata Info Table */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 10px;
      font-size: 9px;
      background-color: #fafbfc;
      border: 1px solid #e5e7eb;
      border-left: 3.5px solid #E65F2B;
      border-radius: 0 4px 4px 0;
      padding: 6px 10px;
    }

    .info-table td {
      padding: 3.5px 6px;
      vertical-align: top;
    }

    .info-table .label {
      font-weight: bold;
      color: #4b5563;
      width: 125px;
    }

    .info-table .value {
      color: #111827;
      width: 35%;
      padding-right: 14px;
    }

    /* Alert Banner Revisi */
    .revision-box {
      border: 1.5px dashed #f59e0b;
      background-color: #fffbeb;
      border-radius: 4px;
      padding: 7px 11px;
      margin-bottom: 10px;
      color: #92400e;
      font-size: 8.5px;
    }

    .revision-box strong {
      display: block;
      font-size: 9px;
      margin-bottom: 2px;
      color: #b45309;
    }

    /* Paragraf Pembuka & Penutup */
    .lead-paragraph {
      font-size: 9px;
      line-height: 1.5;
      color: #374151;
      margin: 8px 0 10px;
      text-align: justify;
    }

    .closing-paragraph {
      font-size: 9px;
      line-height: 1.5;
      color: #1f2937;
      margin: 12px 0 14px;
      font-style: italic;
      font-weight: bold;
    }

    /* Tabel Standar SPARTA */
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5px;
      margin-top: 6px;
      margin-bottom: 12px;
    }

    table.data-table th {
      background-color: #fff7ed;
      color: #c2410c;
      border: 1px solid #fed7aa;
      padding: 5.5px 6px;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 7.5px;
      letter-spacing: 0.3px;
    }

    table.data-table td {
      border: 1px solid #e5e7eb;
      padding: 5px 6px;
      vertical-align: middle;
      color: #1f2937;
    }

    table.data-table tr:nth-child(even) {
      background-color: #fafbfc;
    }

    /* Pill Badges */
    .badge-lingkup {
      display: inline-block;
      padding: 1.5px 5px;
      border-radius: 3px;
      font-weight: bold;
      font-size: 7.5px;
    }

    .badge-lingkup.sipil {
      background-color: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }

    .badge-lingkup.me {
      background-color: #fffbeb;
      color: #b45309;
      border: 1px solid #fde68a;
    }

    .tag-baru {
      display: inline-block;
      background-color: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
      padding: 1.5px 5px;
      border-radius: 3px;
      font-weight: bold;
      font-size: 7px;
      white-space: nowrap;
    }

    .tag-ubah {
      display: inline-block;
      background-color: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
      padding: 1.5px 5px;
      border-radius: 3px;
      font-weight: bold;
      font-size: 7px;
      white-space: nowrap;
    }

    .tag-harga {
      display: inline-block;
      background-color: #fffbeb;
      color: #b45309;
      border: 1px solid #fde68a;
      padding: 1.5px 5px;
      border-radius: 3px;
      font-weight: bold;
      font-size: 7px;
      white-space: nowrap;
    }

    .badge-hadir {
      background-color: #ecfdf5;
      color: #047857;
      font-weight: bold;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 8px;
      border: 1px solid #a7f3d0;
    }

    .badge-absen {
      background-color: #fef2f2;
      color: #b91c1c;
      font-weight: bold;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 8px;
      border: 1px solid #fecaca;
    }

    /* Subsection Header & Grand Total Box */
    .subsection-header {
      font-size: 9.5px;
      font-weight: bold;
      color: #1f2937;
      margin-top: 10px;
      margin-bottom: 5px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .subsection-badge {
      display: inline-block;
      background-color: #E65F2B;
      color: #ffffff;
      font-size: 8px;
      font-weight: bold;
      padding: 1px 6px;
      border-radius: 3px;
      letter-spacing: 0.5px;
    }

    .grand-total-summary {
      margin-top: 10px;
      margin-bottom: 12px;
      background-color: #fff7ed;
      border: 1.5px solid #fed7aa;
      border-radius: 4px;
      padding: 7px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .grand-total-title {
      font-size: 9.5px;
      font-weight: bold;
      color: #9a3412;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .grand-total-amount {
      font-size: 11px;
      font-weight: bold;
      color: #E65F2B;
      font-family: monospace;
    }

    /* Matriks 3 Tanda Tangan Berjenjang (DIBUAT -> MENGETAHUI -> DISETUJUI) */
    .signatures-section {
      margin-top: 14px;
      page-break-inside: avoid;
    }

    .location-date-row {
      text-align: right;
      font-size: 9px;
      font-weight: bold;
      margin-bottom: 8px;
      color: #374151;
    }

    .approval-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 12px 0;
      page-break-inside: avoid;
    }

    .approval-title {
      font-size: 10px;
      font-weight: bold;
      color: #ffffff;
      background: #E65F2B;
      padding: 6px 4px;
      border-radius: 4px 4px 0 0;
      text-transform: uppercase;
      text-align: center;
      letter-spacing: 0.5px;
    }

    .approval-box {
      border: 1px solid #cbd5e1;
      border-top: none;
      background: #fafbfc;
      padding: 8px 6px;
      border-radius: 0 0 4px 4px;
      text-align: center;
      height: 110px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .approval-mid-space {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 6px 0;
      min-height: 45px;
    }

    .approval-date {
      font-size: 8.5px;
      color: #374151;
      font-weight: bold;
      text-align: center;
      line-height: 1.35;
      padding: 0 4px;
    }

    .approval-pending-text {
      font-size: 8px;
      color: #94a3b8;
      font-style: italic;
      text-align: center;
    }

    .approval-bottom {
      margin-top: 4px;
    }

    .approval-name {
      font-weight: bold;
      font-size: 9.5px;
      color: #0f172a;
      text-align: center;
      letter-spacing: 0.3px;
      text-decoration: underline;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .approval-role {
      font-size: 8px;
      color: #475569;
      border-top: 1px solid #e2e8f0;
      padding-top: 4px;
      margin-top: 3px;
      text-align: center;
      line-height: 1.25;
      font-weight: 500;
    }

    /* Footer Catatan Integritas SPARTA */
    .doc-footer {
      margin-top: 16px;
      padding-top: 6px;
      border-top: 1px solid #e5e7eb;
      font-size: 7.5px;
      color: #9ca3af;
      display: flex;
      justify-content: space-between;
    }
  </style>
</head>
<body>

  <!-- Watermark SPARTA Otomatis di Tengah Halaman -->
  {% if watermark_logo_path %}
  <img src="{{ watermark_logo_path }}" class="watermark-img" alt="watermark" />
  {% endif %}

  <!-- Header Banner Oranye SPARTA -->
  <div class="header-main">
    <div style="display: flex; align-items: center;">
      {% if alfamart_logo_path %}
      <img src="{{ alfamart_logo_path }}" class="header-alfamart-logo" alt="Alfamart" />
      {% endif %}
      {% if sparta_logo_path %}
      <img src="{{ sparta_logo_path }}" class="header-sparta-logo" alt="SPARTA" />
      {% endif %}
      <div>
        <h1 class="header-title">SPARTA</h1>
        <p class="header-subtitle">DC Development &bull; Building &amp; Maintenance</p>
      </div>
    </div>
    <div style="text-align: right; color: #fff;">
      <div style="font-size: 13.5px; font-weight: bold; letter-spacing: 0.5px;">BERITA ACARA AANWIJZING</div>
      <div style="font-size: 8.5px; opacity: 0.9; margin-top: 2px;">
        SOP SAT/SOP/DCB/003 &bull; Penyesuaian Fisik &amp; Penambahan Pekerjaan
      </div>
      <div style="font-size: 9.5px; font-weight: bold; opacity: 0.95; margin-top: 3px; font-family: monospace;">
        No. {{ klarifikasi.nomor_klarifikasi }}
      </div>
    </div>
  </div>

  <!-- Section 1: Informasi Dokumen & Proyek -->
  <div class="section-title">I. Informasi Dokumen &amp; Proyek</div>
  <table class="info-table">
    <tr>
      <td class="label">Nomor Berita Acara</td>
      <td class="value">: <strong>{{ klarifikasi.nomor_klarifikasi }}</strong></td>
      <td class="label">Cabang / DC</td>
      <td class="value">: Branch {{ klarifikasi.cabang or project.cabang }}</td>
    </tr>
    <tr>
      <td class="label">Nama Proyek</td>
      <td class="value">: {{ project.nama_proyek }} ({{ project.kode }})</td>
      <td class="label">No. Undangan</td>
      <td class="value">: {{ aanwijzing.nomor_undangan or '-' }}</td>
    </tr>
    <tr>
      <td class="label">Lokasi Bangunan</td>
      <td class="value">: {{ project.alamat or project.cabang }}</td>
      <td class="label">Tanggal Rapat</td>
      <td class="value">: {{ tgl_aanwijzing_indo }}</td>
    </tr>
    <tr>
      <td class="label">Pembuat Dokumen</td>
      <td class="value">: {{ signatures.maker.name }} (Branch Building Koordinator)</td>
      <td class="label">Status Dokumen</td>
      <td class="value">:
        {% if is_approved %}
          <span class="status-badge approved">APPROVED (DISETUJUI FINAL)</span>
        {% elif is_revisi %}
          <span class="status-badge revisi">STATUS: REVISI</span>
        {% else %}
          <span class="status-badge pending">{{ klarifikasi.status }}</span>
        {% endif %}
      </td>
    </tr>
  </table>

  <!-- Section 2: Kesepakatan Durasi Pekerjaan Proyek -->
  <div class="section-title">II. Kesepakatan Durasi Pekerjaan Proyek</div>
  {% if is_durasi_berubah %}
  <table class="info-table" style="border-left-color: #E65F2B; margin-bottom: 8px;">
    <tr>
      <td class="label" style="width: 140px;">Durasi Awal (Penawaran RAB)</td>
      <td class="value">: <strong>{{ durasi_hari_awal }} Hari</strong></td>
      <td class="label" style="width: 140px;">Status Kesepakatan</td>
      <td class="value">:
        <span class="status-badge" style="background-color: #fff7ed; color: #c2410c; border-color: #fed7aa;">
          BERUBAH ({% if selisih_durasi > 0 %}+{% endif %}{{ selisih_durasi }} HARI)
        </span>
      </td>
    </tr>
    <tr>
      <td class="label">Durasi Akhir Klarifikasi</td>
      <td class="value">: <strong style="color: #E65F2B;">{{ durasi_hari_akhir }} Hari</strong></td>
      <td class="label">Catatan Alasan Durasi</td>
      <td class="value">: {{ catatan_durasi or '-' }}</td>
    </tr>
  </table>
  {% else %}
  <div style="border: 1px solid #e2e8f0; background-color: #f8fafc; border-left: 3px solid #059669; padding: 6px 10px; border-radius: 4px; margin-bottom: 8px; font-size: 8.5px; color: #1e293b;">
    <strong>Durasi Pelaksanaan Pekerjaan:</strong> {{ durasi_hari_awal }} Hari
    <span style="display: inline-block; margin-left: 8px; font-weight: bold; color: #047857; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 1.5px 6px; border-radius: 3px; font-size: 7.5px;">
      TETAP SESUAI PENAWARAN RAB/OE (TIDAK BERUBAH)
    </span>
    {% if catatan_durasi %}
      <div style="font-size: 7.5px; color: #64748b; margin-top: 2px;">Catatan: &ldquo;{{ catatan_durasi }}&rdquo;</div>
    {% endif %}
  </div>
  {% endif %}

  <!-- Teks Pengantar SOP Resmi -->
  <div class="lead-paragraph">
    Berdasarkan pengamatan kondisi fisik bangunan eksisting dan klarifikasi teknis pada saat rapat aanwijzing lapangan, disepakati penyesuaian volume, harga, serta penambahan item pekerjaan baru sebagai dasar acuan resmi penawaran tender:
  </div>

  <!-- Section 3: Daftar Rincian Owner Estimate (OE) Lengkap Hasil Klarifikasi Aanwijzing -->
  <div class="section-title">III. Rincian Owner Estimate (OE) Lengkap Hasil Klarifikasi Aanwijzing</div>

  <!-- A. Item Pekerjaan Sipil -->
  <div class="subsection-header">
    <span class="subsection-badge">A</span>
    <span>Rincian Pekerjaan Sipil OE (Lengkap Pasca-Klarifikasi)</span>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25px; text-align: center;">No</th>
        <th>Item Pekerjaan</th>
        <th style="width: 65px; text-align: center;">Volume</th>
        <th style="width: 75px; text-align: right;">Harga Material</th>
        <th style="width: 75px; text-align: right;">Harga Upah</th>
        <th style="width: 80px; text-align: right;">Harga Satuan</th>
        <th style="width: 90px; text-align: right;">Total Biaya</th>
        <th style="width: 85px; text-align: center;">Status</th>
        <th style="width: 100px;">Catatan</th>
      </tr>
    </thead>
    <tbody>
      {% if items_sipil and items_sipil.length > 0 %}
        {% for item in items_sipil %}
        <tr>
          <td style="text-align: center; color: #6b7280;">{{ loop.index }}</td>
          <td>
            <div style="font-size: 7px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.3px;">{{ item.kategori_pekerjaan }}</div>
            <strong style="color: #111827; font-size: 8.5px;">{{ item.deskripsi }}</strong>
          </td>
          <td style="text-align: center; white-space: nowrap;">
            {% if item.is_volume_changed %}
              <div style="text-decoration: line-through; color: #9ca3af; font-size: 7px;">{{ item.volume_awal }} {{ item.satuan }}</div>
              <div style="color: #c2410c; font-weight: bold; font-size: 8.5px;">{{ item.volume_akhir }} {{ item.satuan }}</div>
            {% else %}
              <div style="font-weight: bold; font-size: 8.5px;">{{ item.volume_akhir }} {{ item.satuan }}</div>
            {% endif %}
          </td>
          <td style="text-align: right; font-family: monospace; font-size: 8px; white-space: nowrap;">
            {{ item.harga_material_rp }}
          </td>
          <td style="text-align: right; font-family: monospace; font-size: 8px; white-space: nowrap;">
            {{ item.harga_upah_rp }}
          </td>
          <td style="text-align: right; font-weight: bold; font-family: monospace; font-size: 8px; white-space: nowrap;">
            {{ item.harga_satuan_rp }}
          </td>
          <td style="text-align: right; font-weight: bold; color: #E65F2B; font-family: monospace; font-size: 8px; white-space: nowrap;">
            <div>{{ item.total_biaya_akhir_rp }}</div>
            {% if item.is_total_changed %}
              <div style="font-size: 6.5px; color: #9ca3af; font-weight: normal;">Awal: {{ item.total_biaya_awal_rp }}</div>
            {% endif %}
          </td>
          <td style="text-align: center;">
            {% if item.tipe_perubahan == 'ITEM_BARU' or 'Baru' in item.status_perubahan %}
              <span class="tag-baru">ITEM BARU</span>
            {% elif 'Volume & Harga' in item.status_perubahan %}
              <span class="tag-harga">VOL &amp; HRG</span>
            {% elif 'Volume' in item.status_perubahan %}
              <span class="tag-ubah">VOL UBAH</span>
            {% elif 'Harga' in item.status_perubahan %}
              <span class="tag-harga">HRG UBAH</span>
            {% elif 'RAB Awal' in item.status_perubahan or 'Dikembalikan' in item.status_perubahan or item.tipe_perubahan == 'SAMA_DENGAN_RAB' %}
              <span class="tag-ubah">SESUAI RAB</span>
            {% else %}
              <span class="tag-harga">DISESUAIKAN</span>
            {% endif %}
          </td>
          <td style="font-size: 7.5px; color: #4b5563; font-style: italic; white-space: pre-line;">
            {{ item.catatan or '-' }}
          </td>
        </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td colspan="9" style="text-align: center; color: #64748b; padding: 9px; font-style: italic; background-color: #f8fafc;">
            Tidak ada item pekerjaan Sipil yang tercatat pada berkas ini.
          </td>
        </tr>
      {% endif %}
    </tbody>
    {% if items_sipil and items_sipil.length > 0 %}
    <tfoot>
      <tr style="background-color: #fff7ed; font-weight: bold; border-top: 1.5px solid #fed7aa;">
        <td colspan="6" style="text-align: right; padding: 5px 8px; font-size: 8.5px; text-transform: uppercase; color: #9a3412;">
          Subtotal Pekerjaan Sipil OE :
        </td>
        <td style="text-align: right; padding: 5px 8px; font-size: 9px; color: #E65F2B; font-family: monospace; white-space: nowrap;">
          {{ subtotal_sipil_rp }}
        </td>
        <td colspan="2"></td>
      </tr>
    </tfoot>
    {% endif %}
  </table>

  <!-- B. Item Pekerjaan ME -->
  <div class="subsection-header" style="margin-top: 12px;">
    <span class="subsection-badge">B</span>
    <span>Rincian Pekerjaan ME OE (Lengkap Pasca-Klarifikasi)</span>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25px; text-align: center;">No</th>
        <th>Item Pekerjaan</th>
        <th style="width: 65px; text-align: center;">Volume</th>
        <th style="width: 75px; text-align: right;">Harga Material</th>
        <th style="width: 75px; text-align: right;">Harga Upah</th>
        <th style="width: 80px; text-align: right;">Harga Satuan</th>
        <th style="width: 90px; text-align: right;">Total Biaya</th>
        <th style="width: 85px; text-align: center;">Status</th>
        <th style="width: 100px;">Catatan</th>
      </tr>
    </thead>
    <tbody>
      {% if items_me and items_me.length > 0 %}
        {% for item in items_me %}
        <tr>
          <td style="text-align: center; color: #6b7280;">{{ loop.index }}</td>
          <td>
            <div style="font-size: 7px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.3px;">{{ item.kategori_pekerjaan }}</div>
            <strong style="color: #111827; font-size: 8.5px;">{{ item.deskripsi }}</strong>
          </td>
          <td style="text-align: center; white-space: nowrap;">
            {% if item.is_volume_changed %}
              <div style="text-decoration: line-through; color: #9ca3af; font-size: 7px;">{{ item.volume_awal }} {{ item.satuan }}</div>
              <div style="color: #c2410c; font-weight: bold; font-size: 8.5px;">{{ item.volume_akhir }} {{ item.satuan }}</div>
            {% else %}
              <div style="font-weight: bold; font-size: 8.5px;">{{ item.volume_akhir }} {{ item.satuan }}</div>
            {% endif %}
          </td>
          <td style="text-align: right; font-family: monospace; font-size: 8px; white-space: nowrap;">
            {{ item.harga_material_rp }}
          </td>
          <td style="text-align: right; font-family: monospace; font-size: 8px; white-space: nowrap;">
            {{ item.harga_upah_rp }}
          </td>
          <td style="text-align: right; font-weight: bold; font-family: monospace; font-size: 8px; white-space: nowrap;">
            {{ item.harga_satuan_rp }}
          </td>
          <td style="text-align: right; font-weight: bold; color: #E65F2B; font-family: monospace; font-size: 8px; white-space: nowrap;">
            <div>{{ item.total_biaya_akhir_rp }}</div>
            {% if item.is_total_changed %}
              <div style="font-size: 6.5px; color: #9ca3af; font-weight: normal;">Awal: {{ item.total_biaya_awal_rp }}</div>
            {% endif %}
          </td>
          <td style="text-align: center;">
            {% if item.tipe_perubahan == 'ITEM_BARU' or 'Baru' in item.status_perubahan %}
              <span class="tag-baru">ITEM BARU</span>
            {% elif 'Volume & Harga' in item.status_perubahan %}
              <span class="tag-harga">VOL &amp; HRG</span>
            {% elif 'Volume' in item.status_perubahan %}
              <span class="tag-ubah">VOL UBAH</span>
            {% elif 'Harga' in item.status_perubahan %}
              <span class="tag-harga">HRG UBAH</span>
            {% elif 'RAB Awal' in item.status_perubahan or 'Dikembalikan' in item.status_perubahan or item.tipe_perubahan == 'SAMA_DENGAN_RAB' %}
              <span class="tag-ubah">SESUAI RAB</span>
            {% else %}
              <span class="tag-harga">DISESUAIKAN</span>
            {% endif %}
          </td>
          <td style="font-size: 7.5px; color: #4b5563; font-style: italic; white-space: pre-line;">
            {{ item.catatan or '-' }}
          </td>
        </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td colspan="9" style="text-align: center; color: #64748b; padding: 9px; font-style: italic; background-color: #f8fafc;">
            Tidak ada item pekerjaan ME yang tercatat pada berkas ini.
          </td>
        </tr>
      {% endif %}
    </tbody>
    {% if items_me and items_me.length > 0 %}
    <tfoot>
      <tr style="background-color: #fff7ed; font-weight: bold; border-top: 1.5px solid #fed7aa;">
        <td colspan="6" style="text-align: right; padding: 5px 8px; font-size: 8.5px; text-transform: uppercase; color: #9a3412;">
          Subtotal Pekerjaan ME OE :
        </td>
        <td style="text-align: right; padding: 5px 8px; font-size: 9px; color: #E65F2B; font-family: monospace; white-space: nowrap;">
          {{ subtotal_me_rp }}
        </td>
        <td colspan="2"></td>
      </tr>
    </tfoot>
    {% endif %}
  </table>

  <!-- Ringkasan Total Biaya Penyesuaian Aanwijzing -->
  <div class="grand-total-summary">
    <div class="grand-total-title">Total Nilai Owner Estimate (OE) Pasca-Aanwijzing (Sipil + ME) :</div>
    <div class="grand-total-amount">{{ grand_total_biaya_rp }}</div>
  </div>

  <!-- Section 4: Lampiran Gambar Teknis (Sipil & ME) -->
  <div class="section-title">IV. Lampiran Gambar Teknis (Sipil &amp; ME)</div>
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25px; text-align: center;">No</th>
        <th style="width: 130px;">Kategori Berkas</th>
        <th>Nama Berkas Gambar Teknis</th>
        <th style="width: 90px; text-align: center;">Sumber Berkas</th>
        <th style="width: 110px; text-align: center;">Tautan Google Drive</th>
      </tr>
    </thead>
    <tbody>
      {% for g in gambar_teknis_list %}
      <tr>
        <td style="text-align: center; color: #6b7280;">{{ loop.index }}</td>
        <td><strong>{{ g.label }}</strong></td>
        <td style="font-size: 8px;">
          <div style="font-weight: bold; {% if g.has_revision %}color: #c2410c;{% endif %}">{{ g.nama_file }}</div>
          {% if g.catatan %}
            <div style="font-size: 7px; color: #7c2d12; font-style: italic; margin-top: 1px;">Catatan: &ldquo;{{ g.catatan }}&rdquo;</div>
          {% endif %}
        </td>
        <td style="text-align: center;">
          {% if g.sumber == 'REVISI' %}
            <span class="tag-harga">REVISI</span>
          {% elif g.sumber == 'BARU' %}
            <span class="tag-baru">BARU</span>
          {% elif g.sumber == 'RAB_AWAL' or g.sumber == 'DARI_RAB' %}
            <span class="tag-ubah">RAB AWAL</span>
          {% else %}
            <span style="color: #9ca3af; font-size: 7.5px;">-</span>
          {% endif %}
        </td>
        <td style="text-align: center;">
          {% if g.file_url %}
            <a href="{{ g.file_url }}" target="_blank" style="color: #E65F2B; text-decoration: underline; font-weight: bold; font-size: 8px;">
              Buka File Drive &nearr;
            </a>
          {% else %}
            <span style="color: #9ca3af; font-size: 7.5px;">Tidak Tersedia</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <!-- Section 5: Dokumentasi Foto Lingkungan & Eksisting Proyek -->
  <div class="section-title">V. Dokumentasi Foto Lingkungan &amp; Eksisting Proyek</div>
  {% if foto_lingkungan_list and foto_lingkungan_list.length > 0 %}
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25px; text-align: center;">No</th>
        <th>Keterangan / Label Foto</th>
        <th style="width: 150px;">Koordinat GPS &amp; Lokasi</th>
        <th style="width: 120px;">Waktu Watermark</th>
        <th style="width: 85px; text-align: center;">Sumber</th>
        <th style="width: 90px; text-align: center;">Tautan Asli</th>
      </tr>
    </thead>
    <tbody>
      {% for f in foto_lingkungan_list %}
      <tr>
        <td style="text-align: center; color: #6b7280;">{{ loop.index }}</td>
        <td>
          <strong style="{% if f.sumber == 'REVISI' %}color: #b45309;{% elif f.sumber == 'BARU' %}color: #047857;{% else %}color: #111827;{% endif %}">
            {{ f.nama_file }}
          </strong>
          {% if f.catatan %}
            <div style="font-size: 7px; color: #64748b; font-style: italic; margin-top: 1px;">{{ f.catatan }}</div>
          {% endif %}
        </td>
        <td style="font-size: 7.5px; color: #4b5563;">
          <div>{{ f.gps_coordinate }}</div>
          {% if f.lokasi_wilayah and f.lokasi_wilayah != '-' %}
            <div style="color: #6b7280;">{{ f.lokasi_wilayah }}</div>
          {% endif %}
        </td>
        <td style="font-size: 7.5px; color: #374151;">{{ f.timestamp_watermark }}</td>
        <td style="text-align: center;">
          {% if f.sumber == 'REVISI' %}
            <span class="tag-harga">REVISI</span>
          {% elif f.sumber == 'BARU' %}
            <span class="tag-baru">BARU</span>
          {% else %}
            <span class="tag-ubah">RAB AWAL</span>
          {% endif %}
        </td>
        <td style="text-align: center;">
          {% if f.file_url %}
            <a href="{{ f.file_url }}" target="_blank" style="color: #E65F2B; text-decoration: underline; font-weight: bold; font-size: 8px;">
              Buka Foto &nearr;
            </a>
          {% else %}
            <span style="color: #9ca3af; font-size: 7.5px;">-</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div style="border: 1px solid #e2e8f0; background-color: #f8fafc; border-left: 3px solid #0284c7; padding: 6px 10px; border-radius: 4px; margin-bottom: 10px; font-size: 8.5px; color: #1e293b;">
    <strong>Dokumentasi Foto Lingkungan &amp; Lapangan:</strong>
    <span style="display: inline-block; margin-left: 8px; font-weight: bold; color: #0369a1; background: #f0f9ff; border: 1px solid #bae6fd; padding: 1px 6px; border-radius: 3px; font-size: 7.5px;">
      TETAP SESUAI PENAWARAN RAB/OE
    </span>
    <div style="font-size: 7.5px; color: #64748b; margin-top: 2px;">
      Seluruh dokumentasi kondisi fisik lapangan mengacu penuh pada foto berkas Penawaran RAB/OE awal.
    </div>
  </div>
  {% endif %}

  <!-- Section 6: Daftar Peserta Rapat Aanwijzing -->
  {% if peserta_list and peserta_list.length > 0 %}
  <div class="section-title">VI. Daftar Rekanan Kontraktor Peserta Rapat Aanwijzing</div>
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 25px; text-align: center;">No</th>
        <th>Nama Rekanan / Kontraktor</th>
        <th style="width: 140px;">Email / Kontak</th>
        <th style="width: 95px; text-align: center;">Status Kehadiran</th>
        <th style="width: 170px;">Waktu &amp; Metode Absensi</th>
      </tr>
    </thead>
    <tbody>
      {% for p in peserta_list %}
      <tr>
        <td style="text-align: center; color: #6b7280;">{{ loop.index }}</td>
        <td>
          <strong>{{ p.vendor.nama_perusahaan or p.vendor.nama_vendor }}</strong>
          {% if p.vendor.kode_vendor %}
            <span style="font-size: 7.5px; color: #6b7280;">({{ p.vendor.kode_vendor }})</span>
          {% endif %}
        </td>
        <td style="font-size: 8px; color: #4b5563;">{{ p.email or p.vendor.email or '-' }}</td>
        <td style="text-align: center;">
          {% if p.status_kehadiran_aktual == 'HADIR_AKTUAL' %}
            <span class="badge-hadir">HADIR FISIK</span>
          {% elif p.status_kehadiran_aktual == 'TIDAK_HADIR' or p.status_konfirmasi == 'TIDAK_HADIR' %}
            <span class="badge-absen">TIDAK HADIR</span>
          {% else %}
            <span style="color: #6b7280; font-size: 8px;">BELUM ABSEN</span>
          {% endif %}
        </td>
        <td style="font-size: 8px; color: #1f2937;">
          {% if p.status_kehadiran_aktual == 'HADIR_AKTUAL' %}
            <strong>{{ p.absen_timestamp_indo }}</strong>
            {% if p.absen_metode %}
              <span style="font-size: 7px; color: #047857;">({{ p.absen_metode }})</span>
            {% endif %}
          {% elif p.status_kehadiran_aktual == 'TIDAK_HADIR' %}
            <span style="color: #b91c1c;">Tidak Hadir</span>
            {% if p.catatan_absen %}
              <div style="font-size: 7.5px; color: #6b7280; font-style: italic;">Catatan: {{ p.catatan_absen }}</div>
            {% endif %}
          {% else %}
            <span style="color: #9ca3af;">-</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <!-- Teks Penutup Resmi (Dipindahkan ke setelah Daftar Rekanan Peserta, sebelum Tanda Tangan) -->
  <div class="closing-paragraph">
    Demikian Berita Acara Klarifikasi Hasil Aanwijzing ini dibuat dengan sebenar-benarnya sebagai dasar acuan resmi penawaran tender dan penyusunan kontrak rekanan.
  </div>

  <!-- Matriks 3 Kolom Tanda Tangan Berjenjang (DIBUAT -> MENGETAHUI -> DISETUJUI) -->
  <div class="signatures-section">
    <div class="location-date-row">
      Branch {{ project.cabang or klarifikasi.cabang }}, {{ sign_date }}
    </div>

    <table class="approval-table">
      <tr>
        <!-- Kolom 1: DIBUAT (Branch Building Koordinator) -->
        <td style="width: 33.33%; vertical-align: top; text-align: center;">
          <div class="approval-title">DIBUAT</div>
          <div class="approval-box">
            <div class="approval-mid-space">
              {% if signatures.maker.date %}
                <div class="approval-date">{{ signatures.maker.date }}</div>
              {% else %}
                <div class="approval-date">-</div>
              {% endif %}
            </div>
            <div class="approval-bottom">
              <div class="approval-name">{{ signatures.maker.name | upper }}</div>
              <div class="approval-role">Branch Building Koordinator</div>
            </div>
          </div>
        </td>

        <!-- Kolom 2: MENGETAHUI (Branch Building & Maintenance Manager) -->
        <td style="width: 33.33%; vertical-align: top; text-align: center;">
          <div class="approval-title">MENGETAHUI</div>
          <div class="approval-box">
            <div class="approval-mid-space">
              {% if signatures.approver_1.approved and not is_revisi %}
                <div class="approval-date">{{ signatures.approver_1.date }}</div>
              {% else %}
                <div class="approval-pending-text">( Menunggu Persetujuan )</div>
              {% endif %}
            </div>
            <div class="approval-bottom">
              <div class="approval-name">
                {% if signatures.approver_1.approved and not is_revisi %}
                  {{ signatures.approver_1.name | upper }}
                {% else %}
                  ( .................................................... )
                {% endif %}
              </div>
              <div class="approval-role">Branch Building &amp; Maintenance Manager</div>
            </div>
          </div>
        </td>

        <!-- Kolom 3: DISETUJUI (DC Development Specialist) -->
        <td style="width: 33.33%; vertical-align: top; text-align: center;">
          <div class="approval-title">DISETUJUI</div>
          <div class="approval-box">
            <div class="approval-mid-space">
              {% if signatures.approver_2.approved and not is_revisi %}
                <div class="approval-date">{{ signatures.approver_2.date }}</div>
              {% else %}
                <div class="approval-pending-text">( Menunggu Persetujuan )</div>
              {% endif %}
            </div>
            <div class="approval-bottom">
              <div class="approval-name">
                {% if signatures.approver_2.approved and not is_revisi %}
                  {{ signatures.approver_2.name | upper }}
                {% else %}
                  ( .................................................... )
                {% endif %}
              </div>
              <div class="approval-role">DC Development Specialist</div>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </div>

  <!-- Footer Catatan Integritas SPARTA -->
  <div class="doc-footer">
    <div>Dokumen Berita Acara Klarifikasi Hasil Aanwijzing Resmi &bull; SPARTA DC-Development Module (SOP SAT/SOP/DCB/003)</div>
    <div>Dicetak otomatis pada {{ print_date_time }}</div>
  </div>

</body>
</html>
