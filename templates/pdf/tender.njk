        <div class="header-title-box">
          <h1 class="header-title">SPARTA</h1>
          <p class="header-subtitle">DC Development</p>
        </div>
      </div>
      <div class="header-doc-code">
        <strong>LAMPIRAN SCHEDULE PEKERJAAN</strong>
        No. {{ tender.nomor_tender }}
      </div>
    </div>

    <div class="lampiran-container">
      <div class="lampiran-header">
        <h1 class="lampiran-title">LAMPIRAN</h1>
        <h2 class="lampiran-subtitle">Schedule Pekerjaan &mdash; Proyek {{ project_nama }}</h2>
      </div>

      <table class="gantt-table">
        <thead>
          <!-- Baris 1: Kolom Utama + Tahun -->
          <tr>
            <th rowspan="3" class="gantt-th-orange gantt-col-no">NO</th>
            <th rowspan="3" class="gantt-th-orange gantt-col-desc">DESCRIPTION</th>
            <th rowspan="3" class="gantt-th-orange gantt-col-date">START</th>
            <th rowspan="3" class="gantt-th-orange gantt-col-date">FINISH</th>
            {% for y in gantt_years %}
              <th colspan="{{ y.weeksCount }}" class="gantt-th-orange">{{ y.year }}</th>
            {% endfor %}
          </tr>
          <!-- Baris 2: Nama Bulan -->
          <tr>
            {% for m in gantt_months %}
              <th colspan="{{ m.weeksCount }}" class="gantt-th-month">{{ m.monthName }}</th>
            {% endfor %}
          </tr>
          <!-- Baris 3: Minggu I, II, III, IV -->
          <tr>
            {% for w in gantt_all_weeks %}
              <th class="gantt-th-week gantt-col-week">{{ w.weekRoman }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for grp in schedule_groups %}
            <!-- Baris Header Kategori (Abu-abu Modern) -->
            <tr class="gantt-cat-row">
              <td class="gantt-col-no" style="text-align: center;">{{ grp.roman }}</td>
              <td class="gantt-col-desc" style="font-weight: bold;">{{ grp.title }}</td>
              <td class="gantt-col-date">{{ grp.startFormatted }}</td>
              <td class="gantt-col-date">{{ grp.finishFormatted }}</td>
              {% for active in grp.weekCells %}
                <td class="gantt-col-week {% if active %}bar-green{% endif %}"></td>
              {% endfor %}
            </tr>

            <!-- Sub Aktivitas / Item Kegiatan -->
            {% for it in grp.items %}
              <tr>
                <td class="gantt-col-no" style="text-align: center; color: #4b5563;">{{ it.subNo }}</td>
                <td class="gantt-col-desc" style="padding-left: 6px;">{{ it.description }}</td>
                <td class="gantt-col-date">{{ it.startFormatted }}</td>
                <td class="gantt-col-date">{{ it.finishFormatted }}</td>
                {% for active in it.weekCells %}
                  <td class="gantt-col-week {% if active %}{{ it.barClass }}{% endif %}"></td>
                {% endfor %}
              </tr>
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>

      <!-- Footer Lampiran -->
      <div class="doc-footer" style="margin-top: 15px;">
        <div>Lampiran Schedule Pekerjaan Proyek {{ project_nama }} &bull; SPARTA DC Development</div>
        <div>Halaman Lampiran Jadwal &bull; Dicetak: {{ generated_at }}</div>
      </div>
    </div>
  {% endif %}
</body>
</html>
